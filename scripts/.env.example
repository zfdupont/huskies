# Copy to scripts/.env and fill in real values. settings.py loads this file.

# MongoDB connection string the scripts POST generated plans/summaries to.
# Required only for fill_database.py / seed_db.py (the DB-upload step).
DATABASE_URI="mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority"

# Absolute path to this scripts/ directory. Used to locate generated/ and data/.
# Required by every script (settings.py -> HUSKIES_HOME).
HUSKIES_HOME="/Users/zfdupont/huskies-server/scripts"
